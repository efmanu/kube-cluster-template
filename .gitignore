# --- macOS ---
.DS_Store

# --- Editors / IDEs ---
.vscode/
.idea/

# --- Claude Code local state (machine-specific settings) ---
.claude/

# --- Secrets ---
# BinaryLane API token and any local .env files
src/.env
.env
*.env

# --- Terraform ---
# Provider plugins (downloaded by `terraform init`)
**/.terraform/

# State files (contain resource IDs and may contain secrets)
*.tfstate
*.tfstate.*

# Variable files (contain root_password + k3s_token) — keep the example
*.tfvars
!terraform.tfvars.example

# Saved plan files and crash logs
*.tfplan
crash.log
crash.*.log

